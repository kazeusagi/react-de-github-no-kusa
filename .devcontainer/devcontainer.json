{
  "name": "React de Github no Kusa",
  "image": "oven/bun:1.3.0-slim",
  "runArgs": ["--env-file=.devcontainer/.env"],
  "remoteUser": "bun",
  "workspaceFolder": "/home/bun/app",
  "mounts": [
    "source=${localWorkspaceFolder},target=${containerWorkspaceFolder},type=bind"
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {} // git, curl, user etc.
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oderwat.indent-rainbow",
        "streetsidesoftware.code-spell-checker",
        "biomejs.biome",
        "fabiospampinato.vscode-terminals",
        "formulahendry.auto-rename-tag"
      ]
    }
  }
}
